{
  "manifest_version": 3,
  "name": "Hermes Browser Bridge",
  "version": "0.5.0",
  "description": "Lets a locally running Hermes Agent see and control tabs in this browser, without a remote-debugging port.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "scripting", "tabs", "tabGroups", "storage", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hermes Browser Bridge",
    "default_popup": "popup.html"
  }
}
